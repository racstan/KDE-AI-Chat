#!/usr/bin/env python3
"""KRunner runner for KDE AI Chat (D-Bus service org.kde.kdeaichat.runner), started on demand by D-Bus.
See kdeaichat/krunner.py. Exits by itself when nobody has used it for a minute."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))
from kdeaichat import krunner  # noqa: E402

if __name__ == "__main__":
    sys.exit(krunner.main())
