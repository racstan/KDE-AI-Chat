<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="provider" type="String">
      <default>openai</default>
    </entry>

    <entry name="appDisplayName" type="String">
      <default>KDE AI Chat</default>
    </entry>

    <entry name="baseUrl" type="String">
      <default>https://api.openai.com/v1</default>
    </entry>
    <entry name="apiKey" type="String">
      <default></default>
    </entry>
    <entry name="model" type="String">
      <default></default>
    </entry>

    <entry name="anthropicApiKey" type="String">
      <default></default>
    </entry>
    <entry name="anthropicModel" type="String">
      <default></default>
    </entry>

    <entry name="groqBaseUrl" type="String">
      <default>https://api.groq.com/openai/v1</default>
    </entry>
    <entry name="groqApiKey" type="String">
      <default></default>
    </entry>
    <entry name="groqModel" type="String">
      <default></default>
    </entry>

    <entry name="deepSeekBaseUrl" type="String">
      <default>https://api.deepseek.com</default>
    </entry>
    <entry name="deepSeekApiKey" type="String">
      <default></default>
    </entry>
    <entry name="deepSeekModel" type="String">
      <default></default>
    </entry>

    <entry name="miniMaxBaseUrl" type="String">
      <default>https://api.minimax.io/v1</default>
    </entry>
    <entry name="miniMaxApiKey" type="String">
      <default></default>
    </entry>
    <entry name="miniMaxModel" type="String">
      <default></default>
    </entry>

    <entry name="fireworksBaseUrl" type="String">
      <default>https://api.fireworks.ai/inference/v1</default>
    </entry>
    <entry name="fireworksApiKey" type="String">
      <default></default>
    </entry>
    <entry name="fireworksModel" type="String">
      <default></default>
    </entry>

    <entry name="googleBaseUrl" type="String">
      <default>https://generativelanguage.googleapis.com/v1beta/openai/</default>
    </entry>
    <entry name="googleApiKey" type="String">
      <default></default>
    </entry>
    <entry name="googleModel" type="String">
      <default></default>
    </entry>

    <entry name="openRouterBaseUrl" type="String">
      <default>https://openrouter.ai/api/v1</default>
    </entry>
    <entry name="openRouterApiKey" type="String">
      <default></default>
    </entry>
    <entry name="openRouterModel" type="String">
      <default></default>
    </entry>
    <entry name="openRouterReferer" type="String">
      <default></default>
    </entry>
    <entry name="openRouterTitle" type="String">
      <default>KDE AI Chat</default>
    </entry>

    <entry name="mistralBaseUrl" type="String">
      <default>https://api.mistral.ai/v1</default>
    </entry>
    <entry name="mistralApiKey" type="String">
      <default></default>
    </entry>
    <entry name="mistralModel" type="String">
      <default></default>
    </entry>

    <entry name="cloudflareBaseUrl" type="String">
      <default>https://api.cloudflare.com/client/v4/accounts/YOUR_ACCOUNT_ID/ai/v1</default>
    </entry>
    <entry name="cloudflareApiKey" type="String">
      <default></default>
    </entry>
    <entry name="cloudflareModel" type="String">
      <default></default>
    </entry>

    <entry name="nvidiaBaseUrl" type="String">
      <default>https://integrate.api.nvidia.com/v1</default>
    </entry>
    <entry name="nvidiaApiKey" type="String">
      <default></default>
    </entry>
    <entry name="nvidiaModel" type="String">
      <default></default>
    </entry>

    <entry name="huggingFaceBaseUrl" type="String">
      <default>https://router.huggingface.co/v1</default>
    </entry>
    <entry name="huggingFaceApiKey" type="String">
      <default></default>
    </entry>
    <entry name="huggingFaceModel" type="String">
      <default></default>
    </entry>

    <entry name="xaiBaseUrl" type="String">
      <default>https://api.x.ai/v1</default>
    </entry>
    <entry name="xaiApiKey" type="String">
      <default></default>
    </entry>
    <entry name="xaiModel" type="String">
      <default></default>
    </entry>

    <entry name="lmStudioBaseUrl" type="String">
      <default>http://localhost:1234/v1</default>
    </entry>
    <entry name="lmStudioModel" type="String">
      <default></default>
    </entry>

    <entry name="localBaseUrl" type="String">
      <default>http://localhost:11434/v1</default>
    </entry>
    <entry name="localModel" type="String">
      <default></default>
    </entry>

    <entry name="ollamaBaseUrl" type="String">
      <default>http://localhost:11434/v1</default>
    </entry>
    <entry name="ollamaModel" type="String">
      <default></default>
    </entry>

    <entry name="litellmBaseUrl" type="String">
      <default>http://localhost:4000/v1</default>
    </entry>
    <entry name="litellmApiKey" type="String">
      <default></default>
    </entry>
    <entry name="litellmModel" type="String">
      <default></default>
    </entry>

    <entry name="maritacaBaseUrl" type="String">
      <default>https://chat.maritaca.ai/api</default>
    </entry>
    <entry name="maritacaApiKey" type="String">
      <default></default>
    </entry>
    <entry name="maritacaModel" type="String">
      <default></default>
    </entry>

    <entry name="perplexityBaseUrl" type="String">
      <default>https://api.perplexity.ai/router/v1</default>
    </entry>
    <entry name="perplexityApiKey" type="String">
      <default></default>
    </entry>
    <!-- Key settings from older versions, declared only so the 1.4.0
         migration (store/Migration.qml) can move and clear them. -->
    <entry name="qwenApiKey" type="String"><default></default></entry>
    <entry name="moonshotApiKey" type="String"><default></default></entry>
    <entry name="mimoApiKey" type="String"><default></default></entry>
    <entry name="huggingfaceImageApiKey" type="String"><default></default></entry>
    <entry name="replicateApiKey" type="String"><default></default></entry>
    <entry name="stabilityApiKey" type="String"><default></default></entry>
    <entry name="togetherImageApiKey" type="String"><default></default></entry>
    <entry name="perplexityModel" type="String">
      <default></default>
    </entry>

    <entry name="usePi" type="Bool">
      <default>false</default>
    </entry>
    <entry name="piProvider" type="String">
      <default></default>
    </entry>
    <entry name="piModel" type="String">
      <default></default>
    </entry>
    <entry name="piThinking" type="String">
      <default></default>
    </entry>

    <entry name="useOpenCode" type="Bool">
      <default>false</default>
    </entry>
    <entry name="openCodeUrl" type="String">
      <default>http://127.0.0.1:4096/v1</default>
    </entry>
    <entry name="openCodeProvider" type="String">
      <default></default>
    </entry>
    <entry name="openCodeModel" type="String">
      <default></default>
    </entry>
    <entry name="openCodeAgent" type="String">
      <default></default>
    </entry>
    <entry name="openCodeVariant" type="String">
      <default></default>
    </entry>
    <entry name="openCodeWorkspaceCwd" type="String">
      <default></default>
    </entry>
    <entry name="openCodeUseAgentModel" type="Bool">
      <default>true</default>
    </entry>



    <entry name="enableSystemPrompt" type="Bool">
      <default>true</default>
    </entry>
    <entry name="systemPrompt" type="String">
      <default>You are KDE AI Chat, a precise and helpful assistant. Give accurate answers, ask clarifying questions when context is missing, and clearly state uncertainty instead of inventing facts.</default>
    </entry>

    <!-- Settings → Personality (chat/Personality.js). Empty = not used.
         Tone and personality are preset ids; aiAvatar is a theme icon name
         or the absolute path of an image file. -->
    <entry name="userName" type="String">
      <default></default>
    </entry>
    <entry name="userAbout" type="String">
      <default></default>
    </entry>
    <entry name="userTone" type="String">
      <default></default>
    </entry>
    <entry name="userLanguage" type="String">
      <default></default>
    </entry>
    <entry name="userNotes" type="String">
      <default></default>
    </entry>
    <entry name="aiName" type="String">
      <default></default>
    </entry>
    <entry name="aiPersonality" type="String">
      <default></default>
    </entry>
    <entry name="aiPersonalityCustom" type="String">
      <default></default>
    </entry>
    <entry name="aiAvatar" type="String">
      <default></default>
    </entry>

    <entry name="contextMessageLimit" type="Int">
      <default>-1</default>
    </entry>

    <!-- Memories on or off for every chat (the memories themselves are in
         ~/.local/share/kdeaichat/memory.json, never here). -->
    <entry name="memoryEnabled" type="Bool">
      <default>true</default>
    </entry>
    <!-- Characters of memories sent with a message; 0 = no limit. -->
    <entry name="memoryBudget" type="Int">
      <default>2000</default>
    </entry>
    <!-- Memory settings from older versions, declared only so the 1.4.0
         migration (store/MemoryMigration.qml) can move and clear them. -->
    <entry name="enableMemory" type="Bool"><default>false</default></entry>
    <entry name="userMemory" type="String"><default></default></entry>

    <!-- Whether chats may have their own mode/provider/model, and who wins
         when they do ("chat" or "main"). See chat/EffectiveConfig.js. -->
    <entry name="perChatModelSettings" type="Bool">
      <default>false</default>
    </entry>
    <entry name="perChatPriority" type="String">
      <default>chat</default>
    </entry>

    <entry name="chatSessionsJson" type="String">
      <default>[]</default>
    </entry>
    <entry name="lastSessionId" type="String">
      <default></default>
    </entry>
    <entry name="customPopupWidth" type="Int">
      <default>760</default>
    </entry>
    <entry name="customPopupHeight" type="Int">
      <default>760</default>
    </entry>

    <!-- Look, layout and behaviour customisations (Settings → Appearance and
         Chat). Each default is how the widget looked and behaved before, so
         nothing changes until the user picks something else. The same
         defaults are in contents/ui/chat/Prefs.js (tests/test_prefs.py). -->
    <entry name="chatFontScale" type="Int"><default>100</default><min>50</min><max>200</max></entry>
    <entry name="chatDensity" type="String"><default>normal</default></entry>
    <entry name="chatStyle" type="String"><default>plain</default></entry>
    <entry name="codeTheme" type="String"><default>system</default></entry>
    <entry name="accentColor" type="String"><default></default></entry>
    <entry name="historySide" type="String"><default>left</default></entry>
    <entry name="showWorkspaceBar" type="Bool"><default>true</default></entry>
    <entry name="headerShowHistory" type="Bool"><default>true</default></entry>
    <entry name="headerShowPin" type="Bool"><default>true</default></entry>
    <entry name="headerShowSettings" type="Bool"><default>true</default></entry>
    <entry name="headerShowNewChat" type="Bool"><default>true</default></entry>
    <entry name="headerShowInfo" type="Bool"><default>true</default></entry>
    <entry name="sendKey" type="String"><default>enter</default></entry>
    <entry name="autoScroll" type="Bool"><default>true</default></entry>
    <entry name="timeFormat" type="String"><default>24h</default></entry>
    <entry name="confirmDeleteChat" type="Bool"><default>false</default></entry>
    <entry name="newChatOnOpen" type="Bool"><default>false</default></entry>
    <entry name="playNotificationSound" type="Bool">
      <default>true</default>
    </entry>
    <entry name="notifyOnReply" type="Bool">
      <default>true</default>
    </entry>
    <entry name="notifyOnError" type="Bool">
      <default>true</default>
    </entry>
    <entry name="notifyOnScheduled" type="Bool">
      <default>true</default>
    </entry>
    <entry name="notifyOnInput" type="Bool">
      <default>true</default>
    </entry>
    <entry name="customIcon" type="String">
      <default>dialog-messages</default>
    </entry>
    <!-- The panel icon: "icon" (customIcon), "animated" (GIF, APNG or WebP) or "video" (short, muted, looping); see chat/PanelIcon.js. -->
    <entry name="panelIconMode" type="String">
      <default>icon</default>
    </entry>
    <entry name="panelIconFile" type="String">
      <default></default>
    </entry>
    <entry name="panelIconHoverOnly" type="Bool">
      <default>false</default>
    </entry>
    <entry name="disableStreaming" type="Bool">
      <default>false</default>
    </entry>
    <!-- Direct-mode providers (1.4.0): [{id, name, type, baseUrl, model,
         headers?}]; keys live in KWallet under the id. See ProviderService.js. -->
    <entry name="providersJson" type="String">
      <default></default>
    </entry>
    <entry name="customProvidersJson" type="String">
      <default>[]</default>
    </entry>
    <!-- The image provider /image uses (an id of providersJson with type
         "image"); empty: the first one. See ProviderService.defaultImageProvider. -->
    <entry name="imageProvider" type="String">
      <default></default>
    </entry>
    <!-- When the older free Pollinations service may be asked next:
         {lastAt, blockedUntil} in ms (PollinationsBackend.createPacer). Not secret. -->
    <entry name="pollinationsFreeState" type="String">
      <default></default>
    </entry>
    <entry name="autoNameChats" type="Bool">
      <default>true</default>
    </entry>
    <!-- Direct mode: offer the model the ask_user tool (chat/DirectToolRounds.qml). -->
    <entry name="allowAskUser" type="Bool">
      <default>true</default>
    </entry>
    <!-- Ask before leaving an incognito chat that has messages (chat/Incognito.qml); "Don't ask again" turns it off. -->
    <entry name="incognitoAskBeforeLeaving" type="Bool">
      <default>true</default>
    </entry>

    

      <entry name="promptTemplates" type="String"><default>[]</default></entry>
      <!-- Voice. Read aloud (voiceTtsEnabled) and dictation (sttEnabled) each have their own switch, both off. -->
    <entry name="voiceTtsEnabled" type="Bool"><default>false</default></entry>
    <entry name="voiceTtsAuto" type="Bool"><default>false</default></entry>
    <!-- Migration only (voice/SttConfig.js copies them once into the stt* entries, sttSettingsMigrated):
         the pre-1.4.0 dictation switch, GPU switch, model, model folder and language. -->
    <entry name="voiceEnabled" type="Bool"><default>false</default></entry>
    <entry name="voiceGpuEnabled" type="Bool"><default>false</default></entry>
    <entry name="voiceSttModel" type="String"><default></default></entry>
    <entry name="voiceSttModelPath" type="String"><default></default></entry>
    <entry name="voiceLanguage" type="String"><default>en</default></entry>
    <!-- Read aloud: the engine and each engine's options (voice/TtsEngines.js).
         A speech server's API key is in KWallet (entry "tts-remote"), never here. -->
    <!-- "speechnote" (the Speech Note app) is the default; until it is installed, read aloud uses "system".
         Empty model = Speech Note's own default voice / speech model. -->
    <entry name="voiceTtsEngine" type="String"><default>speechnote</default></entry>
    <entry name="voiceTtsSpeechNoteModel" type="String"><default></default></entry>
    <!-- Minutes Speech Note's service is kept ready after the popup closes (0 = only when used). -->
    <entry name="speechNoteKeepReadyMinutes" type="Int"><default>5</default><min>0</min><max>120</max></entry>
    <entry name="voiceTtsNeuralVoice" type="String"><default>af_heart</default></entry>
    <entry name="voiceTtsNeuralSpeed" type="Double"><default>1</default></entry>
    <entry name="voiceTtsSystemLanguage" type="String"><default></default></entry>
    <entry name="voiceTtsSystemVoice" type="String"><default></default></entry>
    <entry name="voiceTtsSystemRate" type="Double"><default>0</default></entry>
    <entry name="voiceTtsSystemPitch" type="Double"><default>0</default></entry>
    <entry name="voiceTtsKokoroLanguage" type="String"><default></default></entry>
    <entry name="voiceTtsKokoroVoice" type="String"><default></default></entry>
    <entry name="voiceTtsKokoroRate" type="Double"><default>0</default></entry>
    <entry name="voiceTtsFliteVoice" type="String"><default></default></entry>
    <entry name="voiceTtsFliteRate" type="Double"><default>0</default></entry>
    <entry name="voiceTtsFlitePitch" type="Double"><default>0</default></entry>
    <entry name="voiceTtsPiperModel" type="String"><default></default></entry>
    <entry name="voiceTtsPiperSpeaker" type="Int"><default>0</default></entry>
    <entry name="voiceTtsPiperSpeed" type="Double"><default>1</default></entry>
    <entry name="voiceTtsRemoteUrl" type="String"><default>http://localhost:8880/v1</default></entry>
    <entry name="voiceTtsRemoteModel" type="String"><default>tts-1</default></entry>
    <entry name="voiceTtsRemoteVoice" type="String"><default>alloy</default></entry>
    <entry name="voiceTtsRemoteSpeed" type="Double"><default>1</default></entry>
    <entry name="voiceTtsCommand" type="String"><default></default></entry>
    <!-- Dictation: send the transcript at once. -->
    <entry name="voiceAutoSend" type="Bool"><default>true</default></entry>
    <!-- Dictation (speech-to-text). Off by default; with it off nothing is installed or started.
         Passed to the helper's stt_* commands (kdeaichat/stt_settings.py); the remote key is in KWallet, entry "stt-remote". -->
    <entry name="sttEnabled" type="Bool"><default>false</default></entry>
    <!-- speechnote (default), parakeet, faster-whisper, whisper-cpp, remote or command. -->
    <entry name="sttEngine" type="String"><default>speechnote</default></entry>
    <entry name="sttSpeechNoteModel" type="String"><default></default></entry>
    <entry name="sttModel" type="String"><default>small</default></entry>
    <!-- Parakeet: "parakeet-unified-en-0.6b" (found on disk or downloaded) or an absolute .gguf path. -->
    <entry name="sttParakeetModel" type="String"><default>parakeet-unified-en-0.6b</default></entry>
    <!-- auto, cpu, cuda or gpu (cuda and gpu: the graphics card; CUDA for faster-whisper, Vulkan for Parakeet). -->
    <entry name="sttDevice" type="String"><default>auto</default></entry>
    <entry name="sttLanguage" type="String"><default>auto</default></entry>
    <entry name="sttWhisperCppBinary" type="String"><default></default></entry>
    <entry name="sttWhisperCppModel" type="String"><default></default></entry>
    <entry name="sttWhisperCppServer" type="String"><default></default></entry>
    <entry name="sttRemoteUrl" type="String"><default></default></entry>
    <entry name="sttRemoteModel" type="String"><default>whisper-1</default></entry>
    <entry name="sttCommand" type="String"><default></default></entry>
    <!-- Minutes the faster-whisper service keeps its model loaded after the last use (then it exits). -->
    <entry name="sttIdleMinutes" type="Int"><default>5</default><min>1</min><max>120</max></entry>
    <!-- Set once the old voice* dictation settings were copied into the stt* ones. -->
    <entry name="sttSettingsMigrated" type="Bool"><default>false</default></entry>
    <entry name="requestTimeout" type="Int">
      <default>60</default>
    </entry>
    <entry name="walletKeysRevision" type="Int">
      <default>0</default>
    </entry>
  </group>
</kcfg>
